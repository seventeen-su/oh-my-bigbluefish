{
  "name": "@omb/plugin",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "OMB v3 —— DSH 通用认知增强插件（思维链质量 / 记忆 / 上下文优化）",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "onnxruntime-node": "1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.12",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  }
}
