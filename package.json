{
  "name": "@omb/plugin",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "OMB v3 —— DSH 通用认知增强插件（包装配包：一份 profile 补丁 + 8 个组件包）",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "node scripts/build.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@omb/artifact": "workspace:*",
    "@omb/context": "workspace:*",
    "@omb/kernel": "workspace:*",
    "@omb/memory": "workspace:*",
    "@omb/memory-vector": "workspace:*",
    "@omb/notify": "workspace:*",
    "@omb/profile": "workspace:*",
    "@omb/reasoning": "workspace:*",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "onnxruntime-node": "1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.12",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  },
  "files": [
    "lib-gen",
    "packages",
    "cordis.patch.yml",
    "build-generation.json"
  ]
}
