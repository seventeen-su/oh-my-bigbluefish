{
  "id": "web-03",
  "category": "web",
  "requirement": "模拟搜索：按页面规格中的查询词与结果集输出 { query: string, results: { count, items } }。",
  "input_artifacts": [
    {
      "name": "page_spec",
      "description": "搜索页页面规格：query（查询词）、result_ids（命中结果标识列表）",
      "kind": "json",
      "content": {
        "page": "search",
        "query": "benchmark",
        "result_ids": ["r1", "r2", "r3"]
      }
    }
  ],
  "output_schema": {
    "type": "object",
    "properties": {
      "query": { "type": "string" },
      "results": {
        "type": "object",
        "properties": {
          "count": { "type": "number" },
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "required": ["query", "results"]
  },
  "verifier": {
    "kind": "predicate",
    "rules": {
      "predicates": [
        { "path": "results.count", "equals": 3 }
      ]
    }
  },
  "generator": { "name": "web-03 reference", "version": "1.0.0" }
