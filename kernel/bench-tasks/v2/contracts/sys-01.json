      "content": {
        "operation": "create",
        "path": "config.ini",
        "content": "[settings]\nenabled=true"
      }
    }
  ],
  "output_schema": {
    "type": "object",
    "properties": {
      "before": { "type": "object" },
      "after": {
        "type": "object",
        "properties": {
          "config.ini": { "type": "string" }
        }
      }
    },
    "required": ["before", "after"]
  },
