{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "lib-gen",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false,
    "incremental": true,
    "tsBuildInfoFile": "lib-gen/.tsbuildinfo"
  },
  "include": ["kernel", "modules", "dsh", "packages"],
  "exclude": ["lib-gen", "node_modules", "tests"]
}
